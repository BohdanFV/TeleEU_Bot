# ============================================================
# TeleEU Bot environment configuration
# Copy this file to .env and fill real private values locally.
# Do not commit .env to GitHub.
# ============================================================

# Telegram production bot
TELEGRAM_BOT_TOKEN=replace_with_your_production_bot_token
BOT_USERNAME=@EU_UA_Bot

# Telegram test bot / accelerated local testing
TEST_MODE=false
TEST_TELEGRAM_BOT_TOKEN=replace_with_your_test_bot_token
TEST_BOT_USERNAME=@EU_UA_Betabot
# Empty / now = start accelerated test time from the current real time.
# Or use ISO format, for example: 2026-02-10T08:44:50
TEST_FIRST_TIME=
TEST_SPEED_TIME=1
# true = download fresh Google Sheets data in test mode;
# false = use cached data files when available.
TEST_UPDATE_REQUEST=true
TEST_NOTIFY_BEFORE_MINUTES=5

# Google Sheets API
GOOGLE_API_KEY=replace_with_your_google_api_key

# Paths
DATABASE_PATH=data/TeleEU_Bot.db
TEST_DATABASE_PATH=data/TeleEU_Bot_test.db
DATA_DIR=data
LOGS_DIR=logs

# Runtime behavior
NOTIFY_BEFORE_MINUTES=6
UPDATE_SCHEDULE_EVERY_DAY=false
UPDATE_LINKS_ENABLED=true
MONTH_OF_COURSE_CHANGE=7
DAY_OF_COURSE_CHANGE=1

# Retry behavior
SCHEDULE_ATTEMPTS=3
SCHEDULE_ATTEMPT_PAUSE=10
NOTIFICATION_ATTEMPTS=5
NOTIFICATION_ATTEMPT_PAUSE=10
NOTIFICATION_RETRY_WINDOW_MINUTES=5

# Telegram polling
POLLING_TIMEOUT=123
POLLING_RESTART_PAUSE=10

# URLs / external sources
WEB_SCHEDULE_URL=https://shedulem.e-u.edu.ua/
ACCESS_CODES_URL=https://docs.google.com/spreadsheets/d/12dLLtBPWLm7jv3z9lXbjqeOFoQH1f-v2FSDybib4IFo/edit?gid=0#gid=0
FALLBACK_RESOURCES_URL=https://docs.google.com/spreadsheets/d/1a0kG9NY6e7-OreY7nxKmTqPREBTvzsdhq2N1QGvn6gE/edit#gid=0
LINKS_SOURCE_URL=https://shedulem.e-u.edu.ua/config/links.json
FACULTIES_SOURCE_URL=https://shedulem.e-u.edu.ua/config/faculties.json
GOOGLE_SHEETS_API_BASE_URL=https://sheets.googleapis.com/v4/spreadsheets

# Lesson type detection. JSON format.
LESSON_TYPE_KEYWORDS={"zoom":["л","лекція","ккр","шк","захист","іспит","шкзалік"],"meet":["пр","практична","прзалік","залік","лаб"]}

# Logging
LOG_LEVEL=INFO

# Optional developer/debug Telegram chat
DEBUG_CHAT_ID=
DEBUG_ERROR_THREAD_ID=
DEBUG_CRITICAL_THREAD_ID=
